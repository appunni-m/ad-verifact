# Keep the OpenRouter key server-side. Add a spend limit in the OpenRouter dashboard.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai
OPENROUTER_DECISION_MODEL=openai/gpt-6-luna-decisions
OPENROUTER_REPORT_MODEL=openai/gpt-6-luna
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
OPENROUTER_IMAGE_QUALITY=low
AI_TIMEOUT_SECONDS=180
AI_TEXT_CALL_RESERVE_USD=0.50
AI_IMAGE_CALL_RESERVE_USD=2.25
# Request and image processing files are temporary and removed after each stage.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Run thresholds and bounded image processing.
MIN_QUALITY_SCORE=84
MAX_ANALYSIS_IMAGES=8
MAX_IMAGE_EDGE=1600
