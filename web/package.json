{
  "name": "ads-right-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "wrangler types --config wrangler.jsonc --check && tsc -b && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "cf:dev": "wrangler dev --config wrangler.jsonc",
    "cf:deploy": "npm run build && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
